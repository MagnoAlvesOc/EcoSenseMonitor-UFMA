# Configure DOMAIN no .env. Exemplo: ecosense.exemplo.ufma.br
{$DOMAIN} {
  encode zstd gzip
  reverse_proxy web:8000
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  log {
    output stdout
    format console
  }
}
