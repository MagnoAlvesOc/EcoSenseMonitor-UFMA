# Copiar para .env. Nunca versionar segredos reais.
DOMAIN=ecosense.exemplo.ufma.br
PUBLIC_BASE_URL=https://ecosense.exemplo.ufma.br
ENVIRONMENT=production
SECURE_COOKIES=true
SECRET_KEY=SUBSTITUIR_POR_SEGREDO_ALEATORIO_FORTE
POSTGRES_PASSWORD=SUBSTITUIR_SENHA_FORTE_SEM_CARACTERES_URL_ESPECIAIS
APPS_SCRIPT_URL=
SYNC_INTERVAL_SECONDS=120
DISABLE_BACKGROUND_SYNC=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
